{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CostModel",
  "description": "Shape of data/boston-cost-seed.json. Every figure carries a source and confidence.",
  "type": "object",
  "required": [
    "market",
    "updated",
    "data_points",
    "assumptions"
  ],
  "properties": {
    "market": {
      "type": "string"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "data_points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric",
          "value",
          "unit",
          "source_name",
          "source_url",
          "basis",
          "as_of",
          "confidence"
        ],
        "properties": {
          "metric": {
            "enum": [
              "hourly_rate_avg",
              "hourly_rate_low",
              "hourly_rate_high",
              "monthly_cost",
              "annual_all_in_low",
              "annual_all_in_high",
              "placement_fee",
              "daycare_infant_monthly",
              "fica_wage_threshold",
              "fica_employer_rate",
              "ss_wage_base",
              "futa_quarterly_threshold",
              "futa_net_rate",
              "futa_wage_base",
              "ma_pfml_rate",
              "ma_pfml_employer_rate",
              "placement_fee_min",
              "upfront_fee"
            ]
          },
          "segment": {
            "type": "string",
            "description": "e.g. full_time, part_time, newborn, all; for agency fees, the agency (e.g. boston_nanny_centre); for taxes, household_employer"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "enum": [
              "usd_per_hour",
              "usd_per_month",
              "usd_per_year",
              "usd_flat",
              "pct_of_annual_wage",
              "pct_of_wages",
              "usd_per_quarter"
            ]
          },
          "source_name": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "basis": {
            "enum": [
              "listing_asking_rate",
              "provider_reported",
              "survey",
              "government_wage_data",
              "agency_disclosed",
              "family_reported",
              "modeled",
              "government_published"
            ]
          },
          "as_of": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "notes": {
            "type": "string"
          },
          "agency": {
            "type": "string",
            "description": "Agency name, for agency-disclosed fees"
          }
        }
      }
    },
    "assumptions": {
      "type": "object",
      "description": "Known-unknowns. value: null renders as 'TBD \u2014 collecting'. Keys: ma_ui_rate, nanny_share_discount."
    }
  }
}
