# .env.example
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. In production, set these in Vercel →
# Project → Settings → Environment Variables.

# --- Database (Neon Postgres via the Vercel Marketplace) ---
# Vercel adds this automatically once Neon is connected to the project.
# For local dev, run `vercel env pull .env.local` to copy it down.
DATABASE_URL=

# --- Email (Resend) ---
# Create at https://resend.com/api-keys
RESEND_API_KEY=
# Sender address on a domain you've verified in Resend, e.g. briefs@yourdomain.com.
# Until a domain is verified, Resend's test sender "onboarding@resend.dev" works
# (it can only send to your own Resend account email).
EMAIL_FROM=onboarding@resend.dev

# --- Site ---
# Used for links in emails (confirmation links, operator log links).
# Local: http://localhost:3000   Production: https://{{DOMAIN}}
NEXT_PUBLIC_SITE_URL=http://localhost:3000
